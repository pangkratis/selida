{
  "expo": {
    "name": "Selida",
    "slug": "selida",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "selida",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.selida.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fefbf8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.selida.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/selida-splash-light.png",
          "imageWidth": 190,
          "resizeMode": "contain",
          "backgroundColor": "#fefbf8",
          "dark": {
            "image": "./assets/images/selida-splash-dark.png",
            "backgroundColor": "#1F1C18"
          }
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-router",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "af95d387-1b99-419d-b344-16a2bc746230"
      }
    },
    "owner": "pangkratis"
  }
}
